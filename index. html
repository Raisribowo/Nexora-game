<!DOCTYPE html>
<html>
<head>
  <title>Nexora App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0d1117, #111827);
      color: white;
    }

    .container {
      max-width: 420px;
      margin: auto;
      padding: 20px;
    }

    .card {
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(10px);
      padding: 20px;
      border-radius: 20px;
      margin-bottom: 15px;
      box-shadow: 0 0 20px rgba(0,255,150,0.1);
    }

    .title {
      font-size: 14px;
      color: #aaa;
    }

    .big {
      font-size: 28px;
      font-weight: bold;
      color: #00ff99;
      margin-top: 5px;
    }

    button {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;
      background: linear-gradient(90deg, #00ff99, #00ccff);
      color: black;
      font-weight: bold;
      font-size: 16px;
      margin-top: 10px;
      transition: 0.2s;
    }

    button:active {
      transform: scale(0.95);
    }

    input {
      width: 100%;
      padding: 12px;
      border-radius: 12px;
      border: none;
      margin-top: 10px;
    }

    .hidden {
      display: none;
    }

    .header {
      text-align: center;
      font-size: 22px;
      margin-bottom: 20px;
      color: #00ff99;
    }

    .row {
      display: flex;
      justify-content: space-between;
      margin-top: 10px;
      font-size: 14px;
    }
  </style>
</head>

<body>

<div class="container">

  <div class="header">🚀 Nexora</div>

  <!-- LOGIN -->
  <div id="loginBox" class="card">
    <div class="title">Login Player</div>
    <input id="nama" placeholder="Masukkan Nama">
    <button onclick="login()">Masuk</button>
  </div>

  <!-- GAME -->
  <div id="gameBox" class="hidden">

    <div class="card">
      <div class="title">Wallet</div>
      <div class="big" id="saldo">0 NXR</div>
    </div>

    <div class="card">
      <div class="title">Mining</div>
      <div class="row">
        <span>Power</span>
        <span id="power">1</span>
      </div>
      <button onclick="mine()">⛏️ Mining</button>
    </div>

    <div class="card">
      <div class="title">Upgrade</div>
      <div class="row">
        <span>Cost</span>
        <span id="cost">10</span>
      </div>
      <button onclick="upgrade()">Upgrade Skill</button>
    </div>

    <div class="card">
      <button onclick="logout()">Logout</button>
    </div>

  </div>

</div>

<script>
let player = localStorage.getItem("player");

let saldo = 0;
let power = 1;

function login(){
  player = document.getElementById("nama").value;
  if(!player) return alert("Isi nama dulu!");

  localStorage.setItem("player", player);
  load();
  showGame();
}

function load(){
  saldo = parseFloat(localStorage.getItem(player+"_saldo")) || 0;
  power = parseInt(localStorage.getItem(player+"_power")) || 1;
}

function save(){
  localStorage.setItem(player+"_saldo", saldo);
  localStorage.setItem(player+"_power", power);
}

function showGame(){
  document.getElementById("loginBox").classList.add("hidden");
  document.getElementById("gameBox").classList.remove("hidden");
  updateUI();
}

function mine(){
  saldo += power;
  save();
  updateUI();
}

function upgrade(){
  let cost = power * 10;

  if(saldo >= cost){
    saldo -= cost;
    power++;
    save();
  } else {
    alert("NXR tidak cukup!");
  }

  updateUI();
}

function updateUI(){
  document.getElementById("saldo").innerText = saldo + " NXR";
  document.getElementById("power").innerText = power;
  document.getElementById("cost").innerText = power * 10;
}

function logout(){
  localStorage.removeItem("player");
  location.reload();
}

if(player){
  load();
  showGame();
}
</script>

</body>
</html>
